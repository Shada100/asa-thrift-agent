# copy this to .env and fill it in. .env is gitignored, never commit it.

# Chord
CHORD_BASE_URL=https://api.chordhq.xyz
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=

# Paystack - test key only (starts with sk_test_). The server refuses anything else.
PAYSTACK_SECRET_KEY=

# Chord sends this as a bearer token when it calls our tool server.
MCP_TOKEN=
